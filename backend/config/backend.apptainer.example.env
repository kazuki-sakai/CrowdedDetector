# This file is passed into Apptainer with --env-file.
# Keep the real file outside the repository and set mode 600.
CROWDED_API_KEY=replace-with-a-long-random-value
CROWDED_DATA_DIR=/data
CROWDED_MAX_DEVICES=24
CROWDED_MAX_LOCATIONS=12
CROWDED_DEVICE_STALE_SECONDS=35
CROWDED_MAX_IMAGE_BYTES=5242880
CROWDED_QUEUE_SIZE=24

# Use random for the first end-to-end test, then change it to yolo.
CROWDED_DETECTOR=random
CROWDED_RANDOM_MIN_COUNT=0
CROWDED_RANDOM_MAX_COUNT=30
# CROWDED_RANDOM_SEED=12345

CROWDED_YOLO_MODEL=/models/yolo11n.pt
CROWDED_YOLO_DEVICE=0
CROWDED_YOLO_CONFIDENCE=0.35
CROWDED_YOLO_IMAGE_SIZE=640
CROWDED_YOLO_WARMUP_WIDTH=1280
CROWDED_YOLO_WARMUP_HEIGHT=720

# These paths are writable bind mounts supplied by the PBS script.
TORCH_HOME=/cache/torch
YOLO_CONFIG_DIR=/cache/ultralytics

# Uvicorn is reachable only through Nginx on the same host.
CROWDED_BIND_HOST=127.0.0.1
CROWDED_BIND_PORT=8000

#!/bin/bash
#PBS -S /bin/bash
#PBS -N crowded-backend
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail
umask 077

# qsub -v CROWDED_DEPLOY_ROOT=/actual/path で上書きできます。
DEPLOY_ROOT="${CROWDED_DEPLOY_ROOT:-/shared/crowded-detector}"
IMAGE="${DEPLOY_ROOT}/containers/crowded-backend.sif"
ENV_FILE="${DEPLOY_ROOT}/secrets/backend.env"
DATA_DIR="${DEPLOY_ROOT}/runtime/data"
CACHE_DIR="${DEPLOY_ROOT}/runtime/cache"
MODEL_DIR="${DEPLOY_ROOT}/models"
LOCK_FILE="${DEPLOY_ROOT}/runtime/crowded-backend.lock"

echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Start: $(date --iso-8601=seconds)"
echo "Deploy root: ${DEPLOY_ROOT}"

command -v apptainer >/dev/null 2>&1 || {
    echo "ERROR: apptainer command was not found" >&2
    exit 1
}
command -v flock >/dev/null 2>&1 || {
    echo "ERROR: flock command was not found" >&2
    exit 1
}

for required_file in "${IMAGE}" "${ENV_FILE}"; do
    if [ ! -r "${required_file}" ]; then
        echo "ERROR: required file is not readable: ${required_file}" >&2
        exit 1
    fi
done

for required_dir in "${MODEL_DIR}"; do
    if [ ! -d "${required_dir}" ]; then
        echo "ERROR: required directory does not exist: ${required_dir}" >&2
        exit 1
    fi
done

mkdir -p "${DATA_DIR}" "${CACHE_DIR}" "$(dirname "${LOCK_FILE}")"

exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
    echo "ERROR: another CrowdedDetector backend job is already running" >&2
    exit 1
fi

if command -v ss >/dev/null 2>&1 &&
    ss -H -ltn 'sport = :8000' | grep -q .; then
    echo "ERROR: TCP port 8000 is already in use" >&2
    echo "Stop the host systemd backend or the previous PBS job first." >&2
    exit 1
fi

# PBSが割り当てたGPUだけを--cleanenvのコンテナへ明示的に渡します。
if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
    export APPTAINERENV_CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES}"
    echo "CUDA_VISIBLE_DEVICES is set by PBS"
else
    echo "WARNING: PBS did not set CUDA_VISIBLE_DEVICES" >&2
fi

APPTAINER_ARGS=(
    --cleanenv
    --nv
    --env-file "${ENV_FILE}"
    --bind "${DATA_DIR}:/data"
    --bind "${CACHE_DIR}:/cache"
    --bind "${MODEL_DIR}:/models:ro"
)

echo ">>> Checking container configuration..."
apptainer exec "${APPTAINER_ARGS[@]}" "${IMAGE}" \
    python -c "import os, sys; from pathlib import Path; from crowded_backend.settings import Settings; s = Settings.from_env(); problems = ([] if os.access(s.data_dir, os.W_OK) else [f'data directory is not writable: {s.data_dir}']) + ([] if s.detector != 'yolo' or Path(s.yolo_model).is_file() else [f'YOLO model is missing: {s.yolo_model}']); print('Detector:', s.detector); print('Data directory:', s.data_dir); print('YOLO model:', s.yolo_model); [print('ERROR:', problem, file=sys.stderr) for problem in problems]; sys.exit(1 if problems else 0)"

echo ">>> Checking the PBS GPU allocation..."
apptainer exec "${APPTAINER_ARGS[@]}" "${IMAGE}" \
    python -c "import sys, torch; count = torch.cuda.device_count(); print('CUDA available:', torch.cuda.is_available()); print('Visible GPU count:', count); sys.exit(0 if count == 1 else 1)"

echo ">>> Starting Uvicorn on 127.0.0.1:8000..."
echo "The process remains in the foreground so PBS can supervise it."
exec apptainer run "${APPTAINER_ARGS[@]}" "${IMAGE}"

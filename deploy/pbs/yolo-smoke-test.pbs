#!/bin/bash
#PBS -S /bin/bash
#PBS -N crowded-yolo-smoke
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb
#PBS -l walltime=00:10:00
#PBS -j oe

set -euo pipefail
umask 077

DEPLOY_ROOT="${CROWDED_DEPLOY_ROOT:-/shared/crowded-detector}"
IMAGE="${DEPLOY_ROOT}/containers/crowded-backend.sif"
MODEL_DIR="${DEPLOY_ROOT}/models"
MODEL="${MODEL_DIR}/yolo11n.pt"
CACHE_DIR="${DEPLOY_ROOT}/runtime/cache"

echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Start: $(date --iso-8601=seconds)"
echo "Deploy root: ${DEPLOY_ROOT}"

command -v apptainer >/dev/null 2>&1 || {
    echo "ERROR: apptainer command was not found" >&2
    exit 1
}

for required_file in "${IMAGE}" "${MODEL}"; do
    if [ ! -r "${required_file}" ]; then
        echo "ERROR: required file is not readable: ${required_file}" >&2
        exit 1
    fi
done

mkdir -p "${CACHE_DIR}"

if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
    export APPTAINERENV_CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES}"
    echo "CUDA_VISIBLE_DEVICES is set by PBS"
else
    echo "WARNING: PBS did not set CUDA_VISIBLE_DEVICES" >&2
fi

APPTAINER_ARGS=(
    --cleanenv
    --nv
    --env TORCH_HOME=/cache/torch
    --env YOLO_CONFIG_DIR=/cache/ultralytics
    --bind "${CACHE_DIR}:/cache"
    --bind "${MODEL_DIR}:/models:ro"
)

echo ">>> Running YOLO GPU smoke test..."
apptainer exec "${APPTAINER_ARGS[@]}" "${IMAGE}" python - <<'PY'
from time import perf_counter
import sys

import numpy as np
import torch
from ultralytics import YOLO


print("PyTorch:", torch.__version__)
print("CUDA build:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())
print("Visible GPU count:", torch.cuda.device_count())

if not torch.cuda.is_available() or torch.cuda.device_count() != 1:
    print("ERROR: exactly one CUDA GPU must be visible", file=sys.stderr)
    raise SystemExit(1)

print("GPU 0:", torch.cuda.get_device_name(0))

model = YOLO("/models/yolo11n.pt")
print("Model task:", model.task)
print("Class 0:", model.names[0])

image = np.zeros((640, 640, 3), dtype=np.uint8)


def run_once() -> tuple[float, int]:
    started = perf_counter()
    results = model.predict(
        source=image,
        conf=0.35,
        classes=[0],
        device=0,
        verbose=False,
    )
    torch.cuda.synchronize()
    elapsed = perf_counter() - started
    boxes = results[0].boxes if results else None
    return elapsed, 0 if boxes is None else len(boxes)


first_seconds, first_count = run_once()
second_seconds, second_count = run_once()

print(f"First inference: {first_seconds:.4f} seconds, people={first_count}")
print(f"Second inference: {second_seconds:.4f} seconds, people={second_count}")
print(f"GPU memory allocated: {torch.cuda.memory_allocated(0) / 1024**2:.1f} MiB")
print("YOLO GPU smoke test: OK")
PY

echo "Finish: $(date --iso-8601=seconds)"
